# Copy to .env for local dev (gitignored). In production set these via
# `wrangler secret put <NAME>` — never commit real values.

# Deployment environment label (e.g. development | production)
ENVIRONMENT=development

# Shared bearer token authenticating backend <-> worker calls.
# Must match the backend's WORKFLOWS_AUTH_TOKEN. Generate a strong random value.
AUTH_TOKEN=replace-with-a-strong-random-token

# Base URL of the backend that exposes POST /workflows/execute/*
BACKEND_URL=http://localhost:3000
