# Copy to .env for local dev (gitignored). In production set these via
# `wrangler secret put <NAME>` — never commit real values.

# Deployment environment label (e.g. development | production)
ENVIRONMENT=development

# Shared bearer token authenticating backend <-> worker calls.
# Must match the backend's WORKFLOWS_AUTH_TOKEN. Generate a strong random value.
AUTH_TOKEN=replace-with-a-strong-random-token

# Separate backend-only callback credential. Never reuse AUTH_TOKEN: callers
# allowed to dispatch Workflows must not be able to invoke side effects directly.
# Must match the backend's WORKFLOW_CALLBACK_AUTH_TOKEN.
BACKEND_CALLBACK_TOKEN=replace-with-a-different-strong-random-token

# The backend is a required private BACKEND service binding in wrangler.jsonc,
# not a public URL or secret. BACKEND_ORIGIN is a non-secret Wrangler var whose
# authority must match the target API Worker's Host guard.
BACKEND_ORIGIN=https://api.manhali.com
