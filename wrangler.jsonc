{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "manhali-workflows-worker",
  "main": "src/index.ts",
  "account_id": "53fb41ede04e54b276ce3fd9bfd270b6",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js"], "fallthrough": true },
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }
  ],
  // Define custom domains and routes for the worker. This is required for
  // receiving workflow events via HTTP triggers. The pattern should match the
  // domain configured in the workflow's HTTP trigger.
  "routes": [
    {
      "pattern": "workflows.worker.manhali.com",
      "zone_name": "manhali.com",
      "custom_domain": true
    }
  ],

  // Workflows
  // One generic SDK callback Workflow class runs signed backend workflow names.
  "workflows": [
    {
      "name": "manhali-workflow",
      "binding": "WORKFLOW",
      "class_name": "BackendCallbackWorkflow"
    }
  ],

  // Queues (failed event retry)
  // Failed workflow events are sent to a Queue for automatic retry with
  // progressive delays. After max_retries, messages go to a dead-letter queue
  // for manual inspection via the Cloudflare dashboard.
  "queues": {
    "producers": [
      {
        "binding": "FAILED_EVENTS_QUEUE",
        "queue": "manhali-failed-events"
      }
    ],
    "consumers": [
      {
        "queue": "manhali-failed-events",
        "max_retries": 10,
        "dead_letter_queue": "manhali-failed-events-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },

  // Dev settings
  "dev": {
    "port": 8787
  },

  "env": {
    "sandbox": {
      "name": "manhali-workflows-worker-sandbox",
      "account_id": "a793ff57a25dfe6874a8738f9addd295",
      "workers_dev": true,
      "preview_urls": true,
      // No manhali.com custom domain on the sandbox account.
      "routes": [],
      "workflows": [
        {
          "name": "manhali-workflow-sandbox",
          "binding": "WORKFLOW",
          "class_name": "BackendCallbackWorkflow"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "FAILED_EVENTS_QUEUE",
            "queue": "manhali-failed-events-sandbox"
          }
        ],
        "consumers": [
          {
            "queue": "manhali-failed-events-sandbox",
            "max_retries": 10,
            "dead_letter_queue": "manhali-failed-events-sandbox-dlq",
            "max_batch_size": 10,
            "max_batch_timeout": 30
          }
        ]
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1
      }
    }
  }
}
